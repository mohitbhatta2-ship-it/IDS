# Virtual environment
venv/
__pycache__/
*.pyc

# Raw & intermediate data (large, regenerable from raw CSVs)
**/Raw_Data/
**/Cleaned_Parquet/
**/Final_Cleaned/
**/Processed_Data/*.parquet

# CTGAN synthetic data & trained generator models (large)
**/CTGAN/Models/
**/CTGAN/Synthetic/

# Trained ML models (can be large -- .pkl files)
**/Results/Models/*.pkl

# Jupyter checkpoints
.ipynb_checkpoints/

# Allow the webapp deployment bundle even though these subfolder names are excluded above
!webapp_data/
!webapp_data/**

# Django web app
.venv/
webapp_django/db.sqlite3
webapp_django/media/
webapp_django/staticfiles/

# Large generated samples (regenerate from webapp_data/Processed_Data)
sample_data/*20k*.csv
